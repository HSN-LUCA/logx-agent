# Copy this file to .env and fill in your own values. Never commit the real .env.

# Required for the LLM runs (SQL generation, verification, business analysis).
OPENAI_API_KEY=sk-your-real-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Optional: only needed if you point the agent at a live SQL Server instead of
# the bundled SQLite demo databases.
# DB_SERVER=your-server
# DB_DATABASE=your-database
# DB_USERNAME=your-username
# DB_PASSWORD=your-password
# DB_DRIVER=ODBC Driver 17 for SQL Server
